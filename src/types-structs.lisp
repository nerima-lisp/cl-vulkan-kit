;; VkPhysicalDeviceProperties (vulkan_core.h:3702-3712)
(define-vk-struct physical-device-properties
  ((api-version (sb-alien:unsigned 32))
   (driver-version (sb-alien:unsigned 32))
   (vendor-id (sb-alien:unsigned 32))
   (device-id (sb-alien:unsigned 32))
   (device-type (sb-alien:integer 32) (:enum physical-device-type-keyword))
   (device-name (sb-alien:array sb-alien:char 256) (:c-string 256))
   (pipeline-cache-uuid (sb-alien:array (sb-alien:unsigned 8) 16) (:array 16))
   (limits (sb-alien:struct physical-device-limits) (:struct decode-physical-device-limits))
   (sparse-properties (sb-alien:struct physical-device-sparse-properties)
    (:struct decode-physical-device-sparse-properties))))
