;;;; src/types-structs.lisp
;;;;
;;;; Plain data: every field table here is transcribed from
;;;; KhronosGroup/Vulkan-Headers/include/vulkan/vulkan_core.h
;;;; (VK_HEADER_VERSION 360, Vulkan 1.4), not recalled from memory, using the
;;;; C type -> SB-ALIEN type mapping this system uses throughout:
;;;;   uint32_t/VkFlags/VkBool32 -> (unsigned 32)   int32_t -> (integer 32)
;;;;   uint8_t -> (unsigned 8)   uint64_t/VkDeviceSize/size_t -> (unsigned 64)
;;;;   float -> single-float     char* -> c-string
;;;; DEFINE-VK-STRUCT (macros.lisp) turns each table into the matching
;;;; SB-ALIEN struct type plus a decoder.
(in-package #:cl-vulkan-kit)

;; VkExtensionProperties (vulkan_core.h:3745-3748)
(define-vk-struct extension-properties
  ((extension-name (sb-alien:array sb-alien:char 256) (:c-string 256))
   (spec-version (sb-alien:unsigned 32))))

;; VkLayerProperties (vulkan_core.h:3750-3755)
(define-vk-struct layer-properties
  ((layer-name (sb-alien:array sb-alien:char 256) (:c-string 256))
   (spec-version (sb-alien:unsigned 32))
   (implementation-version (sb-alien:unsigned 32))
   (description (sb-alien:array sb-alien:char 256) (:c-string 256))))

;; VkApplicationInfo (vulkan_core.h:3475-3483) -- an "in" struct only, built
;; from Lisp values by CREATE-INSTANCE and never decoded back.
(define-vk-struct application-info
  ((s-type (sb-alien:integer 32))
   (p-next (* t))
   (p-application-name sb-alien:c-string)
   (application-version (sb-alien:unsigned 32))
   (p-engine-name sb-alien:c-string)
   (engine-version (sb-alien:unsigned 32))
   (api-version (sb-alien:unsigned 32)))
  :structure-type 0 ; VK_STRUCTURE_TYPE_APPLICATION_INFO
  :representation nil)

;; VkInstanceCreateInfo (vulkan_core.h:3499-3508) -- likewise "in"-only.
(define-vk-struct instance-create-info
  ((s-type (sb-alien:integer 32))
   (p-next (* t))
   (flags (sb-alien:unsigned 32))
   (p-application-info (* (sb-alien:struct application-info)))
   (enabled-layer-count (sb-alien:unsigned 32))
   (pp-enabled-layer-names (* sb-alien:c-string))
   (enabled-extension-count (sb-alien:unsigned 32))
   (pp-enabled-extension-names (* sb-alien:c-string)))
  :structure-type 1 ; VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO
  :representation nil)

;; VkExtent3D (vulkan_core.h:3404-3408)
(define-vk-struct extent-3d
  ((width (sb-alien:unsigned 32))
   (height (sb-alien:unsigned 32))
   (depth (sb-alien:unsigned 32))))

;; VkQueueFamilyProperties (vulkan_core.h:3714-3719)
(define-vk-struct queue-family-properties
  ((queue-flags (sb-alien:unsigned 32) (:bitmask queue-flags-keywords))
   (queue-count (sb-alien:unsigned 32))
   (timestamp-valid-bits (sb-alien:unsigned 32))
   (min-image-transfer-granularity (sb-alien:struct extent-3d) (:struct decode-extent-3d))))

;; VkPhysicalDeviceSparseProperties (vulkan_core.h:3694-3700)
(define-vk-struct physical-device-sparse-properties
  ((residency-standard-2d-block-shape (sb-alien:unsigned 32) :bool32)
   (residency-standard-2d-multisample-block-shape (sb-alien:unsigned 32) :bool32)
   (residency-standard-3d-block-shape (sb-alien:unsigned 32) :bool32)
   (residency-aligned-mip-size (sb-alien:unsigned 32) :bool32)
   (residency-non-resident-strict (sb-alien:unsigned 32) :bool32)))

